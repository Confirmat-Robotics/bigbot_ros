<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
      <Sequence name="NavigateOnceAndFollow">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>

        <!-- Compute path once, only at start -->
        <RecoveryNode number_of_retries="3" name="PlanOnce">
          <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
          <Sequence>
            <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
            <ClearEntireCostmap name="ClearGlobalCostmap" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
        </RecoveryNode>

        <!-- Keep the plan, tracking a remaining suffix without updating the live controller goal.
             Copy that suffix only after pause has halted FollowPath. This preserves RPP's
             bounded nearest-pose search when a subsequent FollowPath goal resumes. -->
        <PauseResumeController pause_service_name="/navigate_through_poses/pause"
                               resume_service_name="/navigate_through_poses/resume"
                               state_topic="/navigate_through_poses/bt_state">
        <ReactiveSequence name="TrackProgressAndFollow">
          <TruncatePathLocal input_path="{path}" output_path="{resume_path}"
                             distance_forward="inf" distance_backward="1.0"
                             max_robot_pose_search_dist="10.0"/>
        <RecoveryNode number_of_retries="10" name="FollowRetry">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearLocalCostmap" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
        </RecoveryNode>
        </ReactiveSequence>
        <AlwaysSuccess/><!-- PAUSED: keep ticking without motion -->
        <Script code="path := resume_path"/><!-- ON_PAUSE: commit observed route progress -->
        </PauseResumeController>
      </Sequence>

  </BehaviorTree>
</root>
